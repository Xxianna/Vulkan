<?xml version="1.0" encoding="utf-8"?>
<rml>
<head>
	<title>BIM glTF Viewer</title>
	<style>
body {
	font-family: "HarmonyOS Sans SC";
	font-size: 13dp;
	color: #333;
	margin: 0; padding: 0;
	width: 100%; height: 100%;
	overflow: hidden;
	background-color: transparent;
}
#left_panel { position: absolute; top: 134dp; left: 0; bottom: 30dp; width: 180dp; background-color: rgba(245,245,245,230); border-right: 1dp #ccc; overflow: hidden auto; z-index: 90; }
.tree_header { padding: 6dp 8dp; font-size: 12dp; font-weight: bold; color: #555; background-color: rgba(232,232,232,230); border-bottom: 1dp #ddd; }
.tree_search { padding: 4dp 6dp; border-bottom: 1dp #ddd; }
.tree_search input { width: 100%; box-sizing: border-box; font-size: 12dp; padding: 3dp 5dp; border: 1dp #bbb; background-color: #fff; }
	</style>
</head>
<body>

<div id="left_panel">
	<div class="tree_header"><span>&larr;</span> <span>&#128269;</span> 默认组</div>
	<div class="tree_search"><input type="text" placeholder="搜索..."/></div>
</div>

<div style="position:absolute; top:10dp; left:10dp; width:260dp; padding:12dp 16dp; background-color:rgba(20,20,30,200); border:1dp rgba(100,140,200,180); border-radius:6dp; z-index:100;" data-model="physics">
	<h2 style="font-size:16dp; font-weight:bold; color:#8cf;">JoltPhysics Demo</h2>
	<div style="display:block; font-size:14dp; color:#ffffff;">Bodies: {{ body_count }}</div>
	<div style="display:block; font-size:14dp; color:#ffffff;">FPS: {{ fps }}</div>
	<div style="display:block; font-size:14dp; color:#ffffff;">Reset: {{ reset_count }}</div>
	<div style="display:block; font-size:14dp; color:#ffffff;">Next: {{ reset_timer }}s</div>
</div>

</body>
</rml>